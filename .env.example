APP_NAME="Fabric PPC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33306
DB_DATABASE=fabric_ppc
DB_USERNAME=fabric
DB_PASSWORD=secret

# Oracle source (docs/planning/findings.md). No Oracle instance exists yet, so this defaults to a local
# stand-in that lives in the same schema as the app (the Oracle-shaped table names cannot collide).
# Point it at a separate schema, or at the real instance, without touching any code:
#ORACLE_SRC_DATABASE=fabric_oracle_src
#ORACLE_SRC_DRIVER=oracle
#ORACLE_SRC_HOST=
#ORACLE_SRC_PORT=1521
#ORACLE_SRC_USERNAME=
#ORACLE_SRC_PASSWORD=
# ORACLE_SRC_DATABASE is a SID. For a service name use ORACLE_SRC_SERVICE_NAME instead (or ORA-12514),
# or give a full TNS descriptor in ORACLE_SRC_TNS, which wins over host/port/database.
#ORACLE_SRC_SERVICE_NAME=
#ORACLE_SRC_TNS=
# Oracle client charset; defaults to AL32UTF8 when ORACLE_SRC_DRIVER=oracle.
#ORACLE_SRC_CHARSET=AL32UTF8
# Owning schema, for a source that lives in exactly one. Leave it empty for the mill's instance: its data
# spans two schemas (PRODUCTION + ERP) and each source model names its own owner. See config/database.php.
#ORACLE_SRC_SCHEMA_PREFIX=
# 11g (default) compiles a ROWNUM subquery; the mill's instance is 10.2.0.3, so leave it. Only an
# instance on 12.1 or newer may use 12c, which compiles OFFSET/FETCH NEXT.
#ORACLE_SRC_SERVER_VERSION=11g
# Check a configured instance, read-only: php artisan oracle:ping

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# must exceed the Oracle commit job timeout (600 s)
REDIS_QUEUE_RETRY_AFTER=660

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=63790

# Demo users <role>@fabric.local / password (ppc, manager, dept_incharge, colour_lab, dispatch, viewer) are seeded by DemoUsersSeeder — deactivate before go-live
ADMIN_EMAIL=admin@fabric.local
ADMIN_PASSWORD=password

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
