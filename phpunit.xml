<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <!--
        The tests-browser directory is deliberately absent from this file.

        The Pest browser plugin starts a Playwright `run-server` node process as soon as a browser test is
        COLLECTED - before any suite filter, group filter or beforeEach hook can skip it - and then leaves it
        behind holding the run's inherited stdout. A piped bare pest run therefore sat for another
        quarter of an hour after the tests had finished. Listing the directory here would put it back in the
        default run, because Pest collects PHPUnit's configured suites as well as its own test directory.

        Browser tests are run on purpose, and only then: `composer test:browser`
        which passes PEST_BROWSER=1 and points Pest at that directory. See its Pest.php.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
            The Oracle source is pinned to the in-memory stand-in, exactly like the app connection above.
            Without this, a developer with real ORACLE_SRC_* credentials in .env runs the whole suite against
            the mill's live ERP: every OracleSync test either dies with "Unsupported driver [oracle]" (no
            oci8 on the machine) or, once oci8 is installed, reads the real instance. The suite owns its
            source data (OracleMockSeeder) and must never reach outside the process for it.
        -->
        <env name="ORACLE_SRC_DRIVER" value="sqlite"/>
        <env name="ORACLE_SRC_DATABASE" value=":memory:"/>
        <env name="ORACLE_SRC_TNS" value=""/>
        <env name="ORACLE_SRC_SERVICE_NAME" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
